    catch (e) { if (!/Introuvable/.test(String(e.message))) throw e; d = gmailEcrire_('drafts', 'post', corps); } // supprimé entre-temps : recréé
  } else d = gmailEcrire_('drafts', 'post', corps);
  oublierBrouillons_();

ound:var(--ligne)}\n.ec-tete .etat{font-size:12px;color:var(--doux);white-space:nowrap}\n.ec-tete .etat.ok{color:var(--vert)}\n.ec-corps{overflow:auto;padding:10px 14px 0;flex:1;min-height:0;display:flex;flex-direction:column;gap:8px}\n.ec-ligne{display:flex;gap:8px;align-items:center;border-bottom:1px solid var(--ligne);padding:4px 0}\n.ec-ligne>label{flex:none;width:42px;margin:0;font-size:13px;color:var(--doux)}\n.ec-ligne .liens{flex:none;display:flex;gap:4px}\n.ec-ligne .liens button{background:none;border:0;color:var(--lav2);font:600 13px Barlow,sans-serif;cursor:pointer;padding:2px 6px}\n.ec-ligne input{flex:1;min-width:0;background:none;border:0;padding:6px 0;font-size:15px}\n.ec-ligne input:focus{outline:none}\n.chips{flex:1;display:flex;flex-wrap:wrap;gap:4px;align-items:center;min-width:0}\n.chips .chip{display:inline-flex;align-items:center;gap:4px;background:#100e17;border:1px solid var(--ligne);border-radius:999px;padding:2px 6px 2px 10px;font-size:13px;max-width:100%}\n.chips .chip.resa{border-color:var(--lav)}\n.chips .chip.mauvais{border-color:var(--rouge);color:var(--rouge)}\n.chips .chip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.chips .chip button{background:none;border:0;color:var(--doux);cursor:pointer;font-size:14px;padding:0 4px;line-height:1}\n.chips input{flex:1;min-width:120px}\n.ec-outils{display:flex;gap:4px;flex-wrap:wrap;align-items:center}\n.ec-outils button{background:#100e17;border:1px solid var(--ligne);color:var(--texte);border-radius:7px;padding:4px 9px;font:600 13px Barlow,sans-serif;cursor:pointer}\n.ec-outils button.on,.ec-outils button:hover{border-color:var(--lav);color:var(--lav2)}\n.ec-outils .espace{flex:1}\n.ec-outils select{width:auto;padding:4px 8px;font-size:13px;border-radius:7px}\n#ec-texte{min-height:160px;flex:1;background:#fff;color:#1b1733;border-radius:8px;padding:12px 14px;font:16px/1.55 Georgia,\"Times New Roman\",serif;outline:none;overflow-wrap:anywhere}\n#ec-texte:empty:before{content:\"Votre message…\";color:#999}\n#ec-texte p{margin:0 0 .6em}\n#ec-texte a{color:#c81f74}\n.ec-citation{font-size:13px}\n.ec-citation summary{color:var(--doux);cursor:pointer}\n.ec-citation .cadre{background:#fff;border-radius:8px;margin-top:6px;max-height:260px;overflow:auto;padding:8px 10px;color:#333;font:14px/1.5 Arial,sans-serif}\n.ec-pieces{display:flex;flex-wrap:wrap;gap:6px}\n.ec-pieces .pj{padding-right:6px}\n.ec-pieces .pj.envoi{border-style:dashed;color:var(--doux)}\n.ec-bas{display:flex;gap:6px;align-items:center;flex-wrap:wrap;padding:10px 14px 12px;border-top:1px solid var(--ligne)}\n.ec-bas .btn{padding:8px 14px}\n.ec-bas .lien{background:none;border:0;color:var(--doux);font:500 13px Barlow,sans-serif;cursor:pointer;text-decoration:underline;padding:4px}\n.ec-bas .lien.danger{color:var(--rouge)}\n.ec-bas .coche{font-size:13px;color:var(--doux);margin-left:auto}\n.prog-choix{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 10px}\n.prog-choix .btn.petit.on{background:var(--lav);color:#0b0a10}\n.prog-champs{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.prog-champs label{margin:0}\n#dialogue .prog-phrase{margin:10px 0 0;font-size:13px;color:var(--vert)}\n#dialogue .prog-phrase.avert{color:var(--rouge)}\n/* Écrans étroits : liste puis conversation ; fenêtre d'écriture plein écran */\n@media (max-width:999px){\n  .mx.detail .mx-col,.mx.detail .mx-chips{display:none}\n  .mx:not(.detail) .mx-fil{display:none}\n  #mx-ecrire{right:0;left:0;bottom:0;top:0;width:auto;max-height:none;border-radius:0;border:0;transform:none}\n  #mx-ecrire.grand{right:0;width:auto;transform:none}\n  #mx-ecrire.reduit{top:auto;max-height:46px}\n  .ec-tete{border-radius:0;padding-top:max(8px,env(safe-area-inset-top))}\n  .fm header .date{margin-left:0}\n}\n@media (min-width:1000px){\n  .mx-fil .retour{display:none}\n  .mx-chips{display:none}\n}\n/* Colonnes fixes (ordinateur, ≥ 1000 px) : rien ne défile sauf les colonnes ; séparateurs glissables */\n.mx-sep{display:none}\nhtml.mx-fixe,html.mx-fixe body{overflow:hidden;height:100%}\nhtml.mx-fixe main{max-width:none;padding-bottom:0}\nhtml.mx-fixe .mx{grid-template-columns:var(--mc1,210px) 14px var(--mc2,420px) 14px minmax(0,1fr);gap:0;height:var(--mx-haut,calc(100vh - 120px));align-items:stretch}\nhtml.mx-fixe .mx-dossiers{display:flex;flex-direction:column;gap:2px;overflow-y:auto;overscroll-behavior:contain;padding-right:4px;min-height:0}\nhtml.mx-fixe .mx-col{overflow:hidden;min-height:0}\nhtml.mx-fixe .mx-liste{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain;align-content:start;padding-right:2px}\nhtml.mx-fixe .mx-fil{overflow-y:auto;overscroll-behavior:contain;min-height:0;padding:0 2px 0 4px}\nhtml.mx-fixe .mx-sep{display:block;position:relative;cursor:col-resize;touch-action:none;outline:none}\nhtml.mx-fixe .mx-sep::after{content:\"\";position:absolute;top:16px;bottom:16px;left:6px;width:2px;border-radius:2px;background:var(--ligne);transition:background .15s,left .15s,width .15s}\nhtml.mx-fixe .mx-sep:hover::after,html.mx-fixe .mx-sep:focus-visible::after,html.mx-fixe .mx-sep.actif::after{background:var(--lav);left:5px;width:4px}\nhtml.glisse-col,html.glisse-col *{cursor:col-resize!important;user-select:none!important}\nhtml.glisse-col iframe{pointer-events:none}\n\n.renvoi #renvoiDetail{margin:8px 0 0 26px;display:grid;gap:6px;max-width:560px}\n.resumeEv .grandeDate{font:700 20px \"Bricolage Grotesque\",sans-serif}.resumeEv p{margin:6px 0 0;color:var(--doux)}\n#bandeauVoir{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--lav);color:#0b0a10;padding:8px 16px;font-size:14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n#bandeauVoir[hidden]{display:none}\n#bandeauVoir .btn{background:#0b0a10;color:var(--lav);border-color:#0b0a10}\nbody.voir main{padding-bottom:120px}\n.fenetre{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:44;display:flex;align-items:flex-start;justify-content:center;padding:24px 12px;overflow:auto}\n.fenetre[hidden]{display:none}\n.fenetre .boite{background:var(--carte);border:1px solid var(--ligne);border-radius:14px;padding:18px;width:min(96vw,620px);box-shadow:0 20px 60px rgba(0,0,0,.5)}\n.fenetre h4{margin:16px 0 6px;font:700 15px \"Bricolage Grotesque\",sans-serif}\n.titreFenetre{display:flex;gap:10px;align-items:center;justify-content:space-between}.titreFenetre h3{margin:0;font:700 18px \"Bricolage Grotesque\",sans-serif}\n.retrait{margin:8px 0 0 26px;display:grid;gap:6px}\n.typesMailsEv{display:grid;gap:4px}\n.fenetre textarea{min-height:90px}\n.optionResa{display:grid;grid-template-columns:auto 1fr 1.4fr auto auto;gap:8px 10px;align-items:end;background:#100e17;border:1px solid var(--ligne);border-radius:10px;padding:10px;margin-bottom:8px}\n.optionResa .badge{align-self:center}.optionResa label{font-size:13px;color:var(--doux)}\n#ajoutOption{width:auto;max-width:100%}\n.optsResa{display:block;font-size:12px;color:var(--lav2)}\n@media (max-width:760px){.optionResa{grid-template-columns:1fr}}\n</style>\n</head>\n<body>\n<div id=\"charge\"></div>\n<div id=\"bandeauVoir\" hidden>👁 Vous voyez l'appli comme <b></b>. C'est un aperçu : vos actions restent réelles. <button type=\"button\" class=\"btn petit plein\" id=\"finVoir\">Revenir à mon compte</button></div>\n<header>\n  <h1><small id=\"nomFestival\">Festival</small>Réservations</h1>\n  <nav><button data-vue=\"accueil\" class=\"on\">Accueil</button> <button data-vue=\"evenements\">Événements</button> <button data-vue=\"photos\" data-droit=\"photos\">Visuels</button> <button data-vue=\"mails\" data-droit=\"reglages\">E-mails</button> <button data-vue=\"boite\" data-droit=\"boite\">Mails</button> <button data-vue=\"reglages\" data-droit=\"reglages,comptes\">Réglages</button> <button type=\"button\" class=\"discret\" id=\"quitter\" title=\"Changer de compte\">Quitter</button></nav>\n</header>\n<main id=\"vue\"><p class=\"vide\">Chargement…</p></main>\n<input type=\"file\" id=\"fichierPhoto\" accept=\"image/*\" multiple hidden>\n<input type=\"file\" id=\"fichiersGalerie\" accept=\"image/*\" multiple hidden>\n<div id=\"recadrage\"><div class=\"boite\"><canvas id=\"cv\"></canvas><div class=\"reglage\">Zoom <input type=\"range\" id=\"zoom\" min=\"1\" max=\"4\" step=\"0.01\" value=\"1\"> <button type=\"button\" class=\"btn petit\" id=\"tourner\">Tourner</button> <button type=\"button\" class=\"btn petit\" id=\"recentrer\">Recentrer</button> <label class=\"coche\"><input type=\"checkbox\" id=\"reperes\" checked> Repères</label></div>\n<p class=\"aide\">Déplacez la photo pour choisir le cadrage. Le cadre correspond aux photos du programme.</p>\n<div class=\"actions\"><button type=\"button\" class=\"btn plein\" id=\"recadrerOk\">Utiliser cette photo</button><button type=\"button\" class=\"btn\" id=\"recadrerNon\">Annuler</button></div></div></div>\n<div id=\"toast\"></div>\n<div id=\"mx-ecrire\" hidden aria-label=\"Écrire un mail\" role=\"dialog\"></div>\n<div id=\"dialogue\" role=\"dialog\" aria-modal=\"true\"><div class=\"boite\"><h3 id=\"dlgTitre\"></h3><p id=\"dlgTexte\"></p><input id=\"dlgChamp\" hidden><div class=\"actions\"><button type=\"button\" class=\"btn\" id=\"dlgNon\">Annuler</button><button type=\"button\" class=\"btn plein\" id=\"dlgOui\">OK</button></div></div></div>\n\n<script>\nvar CLE = <?!= JSON.stringify(cle) ?>;\n// E-mails de réservation : composition partagée entre le script (envoi) et l'appli (aperçu en direct).\n// Aucune dépendance Apps Script ici : ce fichier est aussi inséré dans Admin.html par assembler.py.\nvar MAIL = (function () {\n  var VARIABLES = [\n    ['nom', 'Prénom et nom', 'Camille Dupont'], ['prenom', 'Prénom', 'Camille'], ['places', 'Nombre de places', '2'],\n    ['titre', 'Titre du spectacle', 'Hurler sous l\\'eau'], ['date', 'Date (en toutes lettres)', 'vendredi 4 décembre 2026'], ['heure', 'Heure', '19:45'],\n    ['lieu', 'Lieu et adresse', 'Théâtricul, Rue de Genève 64, Chêne-Bourg'], ['adresse', 'Adresse seule', 'Rue de Genève 64, Chêne-Bourg'],\n    ['tarif', 'Tarif', 'Prix libre, 10 francs conseillés'], ['numero', 'Numéro de réservation', 'R-7F3K2'], ['email', 'E-mail de la personne', 'camille@example.ch'],\n    ['telephone', 'Téléphone de la personne', '079 000 00 00'], ['message', 'Message laissé', ''], ['festival', 'Nom du festival', 'Le Petit Festival au Théâtricul'],\n    ['options', 'Options choisies (ex. billet + livre)', ''], ['site', 'Adresse du site', 'https://petit-festival.ch'], ['lien', 'Page du spectacle sur le site', 'https://petit-festival.ch/apercu/programme.html#ev1']\n  ];\n  // Un modèle par cas de figure. auto : envoyé tout seul ; sinon envoyé depuis la page de l'événement, à la demande.\n  var TYPES = {\n    confirmation: { nom: 'Confirmation de réservation', sujet: 'sujet', message: 'message', billet: true, auto: true,\n      quand: 'Envoyé tout de suite quand quelqu\\'un réserve sur le site, ou quand vous ajoutez une réservation à la main en cochant « prévenir ».' },\n    attente: { nom: 'Liste d\\'attente', sujet: 'sujetAttente', message: 'messageAttente', billet: false, auto: true,\n      quand: 'Envoyé quand quelqu\\'un s\\'inscrit sur la liste d\\'attente d\\'un événement complet.' },\n    liberee: { nom: 'Une place s\\'est libérée', sujet: 'sujetLiberee', message: 'messageLiberee', billet: true, auto: true,\n      quand: 'Envoyé quand vous passez une inscription de la liste d\\'attente à « Confirmée ».' },\n    annulation: { nom: 'Réservation annulée', sujet: 'sujetAnnulation', message: 'messageAnnulation', billet: false, auto: true,\n      quand: 'Envoyé quand vous annulez une réservation en choisissant « prévenir ».' },\n    rappel: { nom: 'Rappel avant le spectacle', sujet: 'sujetRappel', message: 'messageRappel', billet: true, auto: false, groupe: true,\n      quand: 'À envoyer la veille ou le matin même, à toutes les personnes inscrites, depuis la page de l\\'événement (bouton « Écrire aux inscrits »).' },\n    evenementAnnule: { nom: 'Spectacle annulé ou déplacé', sujet: 'sujetEvenementAnnule', message: 'messageEvenementAnnule', billet: false, auto: false, groupe: true, attente: true,\n      quand: 'À envoyer depuis la page de l\\'événement à toutes les personnes inscrites (liste d\\'attente comprise) si le spectacle est annulé, déplacé ou si l\\'horaire change.' },\n    merci: { nom: 'Merci après le spectacle', sujet: 'sujetMerci', message: 'messageMerci', billet: false, auto: false, groupe: true,\n      quand: 'À envoyer le lendemain depuis la page de l\\'événement : un mot de remerciement, le reste du programme, un lien pour donner son avis…' }\n  };\n  var THEMES = {\n    festival: { nom: 'Festival (nuit)', fond: '#120f24', papier: '#f7f3ff', texte: '#1b1733', doux: '#5b5570', accent: '#ff1fb4', boutonTexte: '#ffffff', accent2: '#6b2cff', bord: '#1b1733', sur: '#f7f3ff', billet: '#f7f0e1', filet: '#d9cdb3' },\n    clair: { nom: 'Clair', fond: '#f7f0e1', papier: '#ffffff', texte: '#1b1733', doux: '#5b5570', accent: '#c81f74', boutonTexte: '#ffffff', accent2: '#1f5bff', bord: '#1b1733', sur: '#f7f3ff', billet: '#f7f0e1', filet: '#d9cdb3' },\n    corail: { nom: 'Corail', fond: '#ff6b57', papier: '#fff8f3', texte: '#2a1410', doux: '#7a4a40', accent: '#c81f74', boutonTexte: '#ffffff', accent2: '#2a1410', bord: '#2a1410', sur: '#ffffff', billet: '#fff1e8', filet: '#ecc9bb' },\n    sobre: { nom: 'Sobre (sans couleur)', fond: '#ffffff', papier: '#ffffff', texte: '#111111', doux: '#666666', accent: '#111111', boutonTexte: '#ffffff', accent2: '#111111', bord: '#111111', sur: '#ffffff', billet: '#ffffff', filet: '#dddddd' }\n  };\n  // Couleurs réglables une à une (elles remplacent celles du thème choisi comme point de départ)\n  var COULEURS = [\n    ['fond', 'Fond autour du mail'], ['papier', 'Fond du mail'], ['texte', 'Texte'], ['doux', 'Texte discret'],\n    ['accent', 'Liens, bouton, étoiles'], ['boutonTexte', 'Texte du bouton'], ['accent2', 'Ombre portée'],\n    ['bord', 'Cadres et bandeaux'], ['sur', 'Texte sur les bandeaux'], ['billet', 'Fond du billet'], ['filet', 'Filets du billet']\n  ];\n  var PIEDS = { simple: 'Simple (filet)', encadre: 'Encadré', bandeau: 'Bandeau de couleur' };\n  var OPTIONS_DEFAUT = { theme: 'festival', couleurs: null, ombre: true, visuel: true, entete: true, bouton: '', lienBouton: 'lien', billet: null, billetModele: 'classique', separateur: 'etoiles' };\n\n  function echapper(t) { return String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;'); }\n  function urlSure(u) { u = String(u || '').trim(); return /^https?:\\/\\//i.test(u) ? u : ''; }\n  function remplir(modele, valeurs) {\n    return String(modele == null ? '' : modele).replace(/\\{(\\w+)\\}/g, function (tout, cle) { return cle in valeurs ? String(valeurs[cle] == null ? '' : valeurs[cle]) : tout; })\n      .replace(/[ \\t]+\\n/g, '\\n');\n  }\n  function couleurSure(c) { c = String(c || '').trim(); return /^#[0-9a-f]{6}$/i.test(c) ? c.toLowerCase() : ''; }\n  // Palette d'un e-mail : le thème de départ, puis les couleurs choisies une à une.\n  function palette(o) {\n    var base = THEMES[o.theme] || THEMES.festival, p = {};\n    Object.keys(base).forEach(function (k) { p[k] = base[k]; });\n    var c = o.couleurs || {}; COULEURS.forEach(function (x) { var v = couleurSure(c[x[0]]); if (v) p[x[0]] = v; });\n    return p;\n  }\n  // Ombre portée en dur (Gmail supprime box-shadow) : un tableau qui ajoute une bande de couleur décalée à droite et en bas.\n  function ombre(interieur, couleur, d, largeur, dessous) {\n    if (!couleur) return interieur;\n    var vide = 'font-size:0;line-height:0;mso-line-height-rule:exactly';\n    return '<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"' + (largeur ? ' width=\"' + largeur + '\"' : '') + ' style=\"border-collapse:collapse' + (largeur ? ';width:' + largeur : '') + '\">' +\n      '<tr><td valign=\"top\" style=\"padding:0\">' + interieur + '
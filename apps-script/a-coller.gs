-titre</button><button type=\"button\" data-mf=\"blockquote\" title=\"Citation\">« Citation »</button><button type=\"button\" data-mf=\"ul\" title=\"Liste à puces\">• Liste</button><button type=\"button\" data-mf=\"p\" title=\"Texte normal\">Normal</button></div>' +\n    '<div class=\"editeurTexte\" id=\"f-' + nom + '-ed\" contenteditable=\"true\" data-vide=\"' + esc(vide || 'Tapez votre texte ici…') + '\">' + mdVersHtml(val) + '</div>' +\n    '<textarea id=\"f-' + nom + '\" name=\"' + nom + '\" hidden>' + esc(val) + '</textarea>' + (aide ? '<p class=\"aide\">' + aide + '</p>' : '') + '</div>';\n}\n// Le texte est gardé dans la feuille en « markdown léger » (**gras**, *italique*, ## sous-titre, > citation, - liste) :\n// c'est ce que le site sait afficher. L'éditeur montre le rendu et convertit dans les deux sens.\nfunction enligne(t) { return esc(t).replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>').replace(/(^|[^*])\\*([^*\\n]+?)\\*/g, '$1<i>$2</i>'); }\nfunction mdVersHtml(md) {\n  var out = '', lignes = String(md || '').replace(/\\r/g, '').split('\\n'), i = 0, par = [];\n  function videPar() { if (par.length) { out += '<p>' + par.map(enligne).join('<br>') + '</p>'; par = []; } }\n  while (i < lignes.length) {\n    var l = lignes[i];\n    if (/^## /.test(l)) { videPar(); out += '<h3>' + enligne(l.slice(3)) + '</h3>'; i++; }\n    else if (/^> /.test(l)) { videPar(); var c = []; while (i < lignes.length && /^> /.test(lignes[i])) c.push(enligne(lignes[i].slice(2))), i++; out += '<blockquote>' + c.join('<br>') + '</blockquote>'; }\n    else if (/^- /.test(l)) { videPar(); var li = []; while (i < lignes.length && /^- /.test(lignes[i])) li.push('<li>' + enligne(lignes[i].slice(2)) + '</li>'), i++; out += '<ul>' + li.join('') + '</ul>'; }\n    else if (!l.trim()) { videPar(); i++; }\n    else { par.push(l); i++; }\n  }\n  videPar(); return out;\n}\nfunction htmlVersMd(racine) {\n  function texte(n) { // contenu en ligne d'un bloc\n    var s = '';\n    n.childNodes.forEach(function (c) {\n      if (c.nodeType === 3) s += c.nodeValue.replace(/\\s+/g, ' ');\n      else if (c.nodeName === 'BR') s += '\\n';\n      else if (c.nodeName === 'B' || c.nodeName === 'STRONG' || (c.style && c.style.fontWeight && +c.style.fontWeight >= 600)) { var t = texte(c).trim(); if (t) s += '**' + t + '**'; }\n      else if (c.nodeName === 'I' || c.nodeName === 'EM' || (c.style && c.style.fontStyle === 'italic')) { var t2 = texte(c).trim(); if (t2) s += '*' + t2 + '*'; }\n      else if (/^(P|DIV|H[1-6]|BLOCKQUOTE|UL|OL|LI)$/.test(c.nodeName)) s += '\\n' + texte(c) + '\\n';\n      else s += texte(c);\n    });\n    return s;\n  }\n  var blocs = [], enLigne = null; // texte et balises en ligne posés directement à la racine : regroupés en un paragraphe\n  function finEnLigne() { if (enLigne) { var t = texte(enLigne).replace(/^\\n+|\\n+$/g, '').trim(); if (t) blocs.push(t); enLigne = null; } }\n  racine.childNodes.forEach(function (n) {\n    var nom = n.nodeName;\n    if (n.nodeType === 3 || /^(B|STRONG|I|EM|SPAN|A|U|BR|FONT)$/.test(nom)) { if (!enLigne) enLigne = document.createElement('div'); enLigne.appendChild(n.cloneNode(true)); return; }\n    finEnLigne();\n    if (/^H[1-6]$/.test(nom)) blocs.push('## ' + texte(n).trim().replace(/\\n+/g, ' '));\n    else if (nom === 'BLOCKQUOTE') blocs.push(texte(n).trim().split(/\\n+/).map(function (l) { return '> ' + l.trim(); }).join('\\n'));\n    else if (nom === 'UL' || nom === 'OL') blocs.push(Array.prototype.map.call(n.querySelectorAll('li'), function (li) { return '- ' + texte(li).trim().replace(/\\n+/g, ' '); }).join('\\n'));\n    else if (nom === 'BR') return;\n    else { var t = texte(n).replace(/^\\n+|\\n+$/g, '').replace(/\\n{2,}/g, '\\n'); if (t.trim()) blocs.push(t); }\n  });\n  finEnLigne();\n  return blocs.join('\\n\\n').replace(/[ \\t]+\\n/g, '\\n').trim();\n}\nfunction miseEnFormeInit(racine) {\n  try { document.execCommand('defaultParagraphSeparator', false, 'p'); } catch (e) {}\n  (racine || document).querySelectorAll('.editeurTexte').forEach(function (ed) {\n    var ta = $('#' + ed.id.replace(/-ed$/, ''));\n    function sync() { ta.value = htmlVersMd(ed); }\n    ed.addEventListener('input', sync);\n    ed.addEventListener('focus', function () { if (!ed.innerHTML.trim()) { ed.innerHTML = '<p><br></p>'; var r = document.createRange(); r.setStart(ed.firstChild, 0); r.collapse(true); var s = getSelection(); s.removeAllRanges(); s.addRange(r); } });\n    ed.addEventListener('blur', function () { sync(); if (ta.value !== htmlVersMd(ed)) return; });\n    ed.addEventListener('paste', function (ev) { ev.preventDefault(); var t = (ev.clipboardData || window.clipboardData).getData('text/plain'); document.execCommand('insertText', false, t); });\n    ed.addEventListener('keydown', function (ev) {\n      if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === 'b') { ev.preventDefault(); document.execCommand('bold'); sync(); }\n      if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === 'i') { ev.preventDefault(); document.execCommand('italic'); sync(); }\n    });\n    ed.addEventListener('keyup', function () { etatBarre(ed); });\n    ed.addEventListener('mouseup', function () { etatBarre(ed); });\n  });\n  function etatBarre(ed) {\n    var barre = ed.parentNode.querySelector('.barreTexte'); if (!barre) return;\n    var bloc = (document.queryCommandValue('formatBlock') || '').toLowerCase();\n    barre.querySelectorAll('button').forEach(function (b) {\n      var m = b.dataset.mf, on = false;\n      try { on = m === 'bold' ? document.queryCommandState('bold') : m === 'italic' ? document.queryCommandState('italic') : m === 'ul' ? document.queryCommandState('insertUnorderedList') : m === 'h3' ? bloc === 'h3' : m === 'blockquote' ? bloc === 'blockquote' : false; } catch (e) {}\n      b.classList.toggle('on', !!on);\n    });\n  }\n  (racine || document).querySelectorAll('.barreTexte button').forEach(function (b) {\n    b.onmousedown = function (ev) { ev.preventDefault(); }; // garder la sélection dans l'éditeur\n    b.onclick = function () {\n      var ed = $('#' + b.parentNode.dataset.pour + '-ed'), m = b.dataset.mf; ed.focus();\n      if (m === 'bold' || m === 'italic') document.execCommand(m);\n      else if (m === 'ul') document.execCommand('insertUnorderedList');\n      else if (m === 'h3' || m === 'blockquote') { var bloc = (document.queryCommandValue('formatBlock') || '').toLowerCase(); document.execCommand('formatBlock', false, bloc === m ? 'p' : m); }\n      else document.execCommand('formatBlock', false, 'p');\n      ed.dispatchEvent(new Event('input', { bubbles: true })); etatBarre(ed);\n    };\n  });\n}\n\n// Durée ↔ heure de fin\nfunction minutesDe(duree) { var m = /(\\d+)\\s*h\\s*(\\d+)?/i.exec(duree); if (m) return Number(m[1]) * 60 + Number(m[2] || 0); m = /(\\d+)\\s*(min|mn|')?/.exec(duree); return m ? Number(m[1]) : 0; }\nfunction texteDuree(min) { if (!min) return ''; var h = Math.floor(min / 60), m = min % 60; return h ? h + ' h' + (m ? ' ' + ('0' + m).slice(-2) : '') : m + ' min'; }\nfunction heurePlus(debut, min) { var p = debut.split(':'); if (p.length < 2) return ''; var t = (Number(p[0]) * 60 + Number(p[1]) + min) % 1440; return ('0' + Math.floor(t / 60)).slice(-2) + ':' + ('0' + (t % 60)).slice(-2); }\nfunction ecartMinutes(debut, fin) { var a = debut.split(':'), b = fin.split(':'); if (a.length < 2 || b.length < 2) return 0; var t = (Number(b[0]) * 60 + Number(b[1])) - (Number(a[0]) * 60 + Number(a[1])); return t < 0 ? t + 1440 : t; }\n\nvar MODIFIE = false;\nwindow.addEventListener('beforeunload', function (ev) { if (MODIFIE) { ev.preventDefault(); ev.returnValue = ''; } });\n\nfunction afficherEvenement(id) {\n  var nouveau = id === 'nouveau' || id === 'copie';\n  var e = id === 'nouveau' ? { statut: 'Brouillon', places: '45', lieu: 'Théâtricul', adresse: 'Chêne-Bourg' } : (id === 'copie' ? afficherEvenement.copie : D.evenements.filter(function (x) { return x.id === id; })[0]);\n  if (!e) { ouvert = null; return
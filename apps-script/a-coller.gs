même que le titre\"') +\n    champ('compagnie', 'Compagnie / artistes', e.compagnie) +\n    champ('date', 'Date', e.date, 'date', 'required') +\n    champ('debut', 'Début', e.debut, 'time') +\n    champ('fin', 'Fin (calculée depuis la durée)', e.fin, 'time') +\n    champ('duree', 'Durée (ou calculée depuis la fin)', e.duree, 'text', 'placeholder=\"50 min\"') +\n    champ('age', 'Âge', e.age, 'text', 'placeholder=\"Dès 6 ans, tout public…\"') +\n    champ('lieu', 'Lieu', e.lieu) +\n    champ('adresse', 'Adresse', e.adresse) +\n    champ('tarif', 'Tarif (texte)', e.tarif, 'text', 'placeholder=\"Prix libre, paiement sur place\"') +\n    champ('places', 'Nombre de places (vide = illimité)', e.places, 'number', 'min=\"0\"') +\n    '<div><label>Quand c\\'est complet</label><label class=\"coche\"><input type=\"checkbox\" name=\"attente\" value=\"Oui\"' + (e.attente === 'Oui' ? ' checked' : '') + '> ouvrir une liste d\\'attente</label><p class=\"aide\">Le site affiche « Complet » et bloque les réservations ; avec la liste d\\'attente, les gens peuvent s\\'inscrire et vous les confirmez ici quand une place se libère.</p></div>' +\n    '<div class=\"large\"><h3 class=\"section\">Options de réservation</h3><p class=\"aide\">Elles s\\'ajoutent au formulaire de réservation du site pour cet événement : une case en plus (ex. « Billet + livre »), ou des places réservées à un groupe (ex. « Société des écrivains »), que le public ne peut pas prendre.</p>' +\n    '<div id=\"optionsResa\"></div><select id=\"ajoutOption\" aria-label=\"Ajouter une option\"></select><input type=\"hidden\" name=\"options\" id=\"f-options\" value=\"' + esc(e.options || '') + '\"></div>' +\n    '<div class=\"large\"><h3 class=\"section\">E-mails de cet événement</h3><p class=\"aide\" id=\"resumeMailsEv\"></p><button type=\"button\" class=\"btn\" id=\"ouvrirMailsEv\">Paramètres des mails de cet événement…</button>' +\n    '<input type=\"hidden\" name=\"mailsEv\" id=\"f-mailsEv\" value=\"' + esc(e.mailsEv || '
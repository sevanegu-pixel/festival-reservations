  cleDossierPhotos: 'RESA_DOSSIER_PHOTOS',
  cleComptes: 'RESA_COMPTES',
  cleAppareils: 'RESA_APPAREILS',
  dureeAppareil: 180, // jours sans utilisation avant de redemander le code PIN
};

